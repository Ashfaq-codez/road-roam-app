/* admin-frontend/src/index.css */

/* 1. Import the Poppins font (MUST BE FIRST) */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');

/* 2. CRITICAL FIX: Use the single, clean v4 import directive */
@import 'tailwindcss'; 


/* 3. Set the base font and background for the site */
@layer base {
  html {
    /* Apply the Poppins font */
    font-family: 'Poppins', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  body {
    /* Set the dark Slate Auto background and remove conflicting styles */
    background-color: #1a1a1a; 
    margin: 0;
    display: block; 
    min-height: 100vh;
    min-width: 320px;
    color: #3d1717; 
  }

  :root {
    color-scheme: dark; 
    color: #f0f0f0;
    background-color: #1a1a1a;
  }
}
</file>

